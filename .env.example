# Copy to .env.local for local development. Never commit real credentials.
# Render: set secrets in the service Environment settings; do not commit keys.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local development uses SQLite when Turso is not configured.
SCENTLY_DB_PATH=./storage/scently.sqlite
# Optional canonical URL. Render's assigned URL is used automatically otherwise.
NEXT_PUBLIC_SITE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional licensed bottle-photo fallback. Set the key only in Render Environment.
# Free plan: 20 requests/month. Raise this limit only for a plan you have chosen.
FRAGELLA_API_KEY=
FRAGELLA_PHOTO_MONTHLY_LIMIT=20
# Comma-separated Scently account IDs from /api/me; empty denies admin access.
ADMIN_USER_IDS=
CONTACT_EMAIL=
